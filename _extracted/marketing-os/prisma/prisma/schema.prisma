// ============================================================================
// DOMAIN 1: ORGANIZATION
// ============================================================================

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @db.VarChar(8)
  name      String   @db.VarChar(120)
  legalName String?  @map("legal_name") @db.VarChar(200)
  timezone  String   @default("Asia/Bangkok") @db.VarChar(40)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?  @map("deleted_by") @db.Uuid

  teams                 Team[]
  assignments           EmployeeAssignment[]
  scopeGrants           ScopeGrant[]
  featureFlags          FeatureFlag[]
  workflowInstances     WorkflowInstance[]
  attendanceRecords     AttendanceRecord[]
  overtimeRecords       OvertimeRecord[]
  leaveRequests         LeaveRequest[]
  leaveRescheduleRequests LeaveRescheduleRequest[]
  leaveShiftSwapRequests  LeaveShiftSwapRequest[]
  holidayConversions    HolidayConversion[]
  payrollCycles         PayrollCycle[]
  payrollItems          PayrollItem[]
  salaryHistory         SalaryHistory[]
  deposits              Deposit[]
  commissionRecords     CommissionRecord[]
  bigLeaderLedgers      BigLeaderLedger[]
  marketingCommissionCycles MarketingCommissionCycle[]
  marketingCommissionCarryForwards MarketingCommissionCarryForward[]
  marketingDailyReports         MarketingDailyReport[]
  marketingReportAuditLogs      MarketingReportAuditLog[]
  marketingCycleLocks           MarketingCycleLock[]
  marketingExpenses             MarketingExpense[]
  marketingTeams                MarketingTeam[]
  marketingTeamMembers          MarketingTeamMember[]
  adminCommissionCycles AdminCommissionCycle[]
  adminCommissionEmployeeProfiles AdminCommissionEmployeeProfile[]
  adminCommissionShiftSegments AdminCommissionShiftSegment[]
  commissionCycles      CommissionCycle[]
  commissionAdjustments CommissionAdjustmentRequest[]
  commissionDeclarations CommissionDeclaration[]
  commissionDeclarationAssignments CommissionDeclarationAssignment[]
  advanceRequests       AdvanceRequest[]
  depositRefunds        DepositRefund[]
  ledgerEntries         LedgerEntry[]
  performanceCycles     PerformanceCycle[]
  evaluations           Evaluation[]
  candidates            Candidate[]
  referrals             Referral[]
  costCenters           CostCenter[]
  budgets               Budget[]
  financialTransactions FinancialTransaction[]
  assets                Asset[]
  kbArticles            KbArticle[]
  reportSnapshots       ReportSnapshot[]
  kpiDailyFacts         KpiDailyFact[]
  announcements         Announcement[]
  systemSettings        SystemSetting[]
  ruleConfigProfiles    RuleConfigProfile[]

  /// NOTE: unique (code) WHERE deleted_at IS NULL — partial unique in raw SQL
  @@index([code])
  @@map("companies")
  @@schema("organization")
}

model Function {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy   String?  @map("deleted_by") @db.Uuid

  teams              Team[]
  assignments        EmployeeAssignment[]
  commissionTargets  CommissionTarget[]

  /// NOTE: unique (code) WHERE deleted_at IS NULL — partial unique in raw SQL
  @@index([code])
  @@map("functions")
  @@schema("organization")
}

model Team {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  functionId          String?  @map("function_id") @db.Uuid
  name                String   @db.VarChar(120)
  parentTeamId        String?  @map("parent_team_id") @db.Uuid
  bigLeaderEmployeeId String?  @map("big_leader_employee_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy           String?  @map("deleted_by") @db.Uuid

  company      Company   @relation(fields: [companyId], references: [id])
  function     Function? @relation(fields: [functionId], references: [id])
  parentTeam   Team?     @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams   Team[]    @relation("TeamHierarchy")
  bigLeader    Employee? @relation("TeamBigLeader", fields: [bigLeaderEmployeeId], references: [id])

  assignments       EmployeeAssignment[]
  scopeGrants       ScopeGrant[]
  redistributions   CommissionRedistribution[]
  announcements     Announcement[]

  /// NOTE: unique (company_id, name) WHERE deleted_at IS NULL — partial unique in raw SQL
  @@index([companyId])
  @@index([parentTeamId])
  @@map("teams")
  @@schema("organization")
}

// ============================================================================
// DOMAIN 2: EMPLOYEE
// ============================================================================

model Employee {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  globalId           String           @map("global_id") @db.VarChar(12)
  firstName          String           @map("first_name") @db.VarChar(100)
  lastName           String           @map("last_name") @db.VarChar(100)
  nickname           String?          @db.VarChar(60)
  nationalId         String?          @map("national_id") @db.VarChar(64)
  phone              String?          @db.VarChar(32)
  email              String?          @db.VarChar(160)
  dateOfBirth        DateTime?        @map("date_of_birth") @db.Date
  hireDate           DateTime         @map("hire_date") @db.Date
  probationEndDate   DateTime?        @map("probation_end_date") @db.Date
  terminationDate    DateTime?        @map("termination_date") @db.Date
  employmentStatus   EmploymentStatus @default(probation) @map("employment_status")
  rehireOfEmployeeId String?          @map("rehire_of_employee_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy          String?          @map("created_by") @db.Uuid
  updatedBy          String?          @map("updated_by") @db.Uuid
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz()
  deletedBy          String?          @map("deleted_by") @db.Uuid

  rehireOf   Employee?  @relation("Rehire", fields: [rehireOfEmployeeId], references: [id])
  rehires    Employee[] @relation("Rehire")

  ledTeams              Team[]                     @relation("TeamBigLeader")
  users                 User[]
  assignments           EmployeeAssignment[]
  documents             EmployeeDocument[]
  bankAccounts          EmployeeBankAccount[]
  attendanceRecords     AttendanceRecord[]
  overtimeRecords       OvertimeRecord[]
  attendanceReminders   AttendanceReminder[]
  leaveBalances         LeaveBalance[]
  leaveRequests           LeaveRequest[]
  leaveRescheduleRequests LeaveRescheduleRequest[]
  shiftSwapsRequested     LeaveShiftSwapRequest[] @relation("ShiftSwapRequester")
  shiftSwapsAsPartner     LeaveShiftSwapRequest[] @relation("ShiftSwapPartner")
  holidayConversions      HolidayConversion[]
  payrollItems          PayrollItem[]
  payslips              Payslip[]
  salaryHistory         SalaryHistory[]
  deposits              Deposit[]
  commissionRecords     CommissionRecord[]
  commissionSplits      CommissionSplit[]
  redistributions       CommissionRedistribution[]
  bigLeaderLedgers      BigLeaderLedger[]
  marketingCommissionMemberResults MarketingCommissionMemberResult[]
  marketingCommissionCarryForwards MarketingCommissionCarryForward[]
  marketingCommissionCyclesLed MarketingCommissionCycle[] @relation("MarketingCycleBigLeader")
  marketingCommissionRedistributionsReceived MarketingCommissionRedistribution[] @relation("MarketingRedistributionRecipient")
  marketingDailyReports MarketingDailyReport[]
  marketingExpenses     MarketingExpense[]
  marketingTeamsLedAsBigLeader MarketingTeam[] @relation("MarketingTeamBigLeader")
  marketingTeamsLedAsSubLeader MarketingTeam[] @relation("MarketingTeamSubLeader")
  marketingTeamMemberships MarketingTeamMember[]
  adminCommissionMemberResults AdminCommissionMemberResult[]
  adminCommissionEmployeeProfiles AdminCommissionEmployeeProfile[]
  adminCommissionShiftSegments AdminCommissionShiftSegment[]
  adminCommissionPenalties AdminCommissionPenalty[]
  adminCommissionRedistributionsReceived AdminCommissionRedistribution[] @relation("AdminRedistributionRecipient")
  commissionAdjustments CommissionAdjustmentRequest[] @relation("CommissionAdjustmentEmployee")
  commissionAdjustmentEntries CommissionAdjustmentEntry[] @relation("CommissionAdjustmentEntryEmployee")
  commissionDeclarations CommissionDeclaration[]
  advanceRequests       AdvanceRequest[]
  depositRefunds        DepositRefund[]
  evaluations           Evaluation[]
  recruitedCandidates   Candidate[]
  referralsMade         Referral[]                 @relation("Referrer")
  referralsReceived     Referral[]                 @relation("Referred")
  probationReviews      ProbationReview[]
  trainingAssignments   TrainingAssignment[]
  assetAssignments      AssetAssignment[]
  announcementDeliveries AnnouncementDelivery[]

  /// NOTE: CHECK global_id ~ '^EMP[0-9]{6}$'; unique (global_id) WHERE deleted_at IS NULL — raw SQL
  @@index([globalId])
  @@index([rehireOfEmployeeId])
  @@index([employmentStatus])
  @@map("employees")
  @@schema("employee")
}

model EmployeeAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  teamId           String?   @map("team_id") @db.Uuid
  functionId       String?   @map("function_id") @db.Uuid
  roleLevel        RoleLevel @default(employee) @map("role_level")
  isPrimaryCompany Boolean   @default(false) @map("is_primary_company")
  isPrimaryTeam    Boolean   @default(false) @map("is_primary_team")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy        String?   @map("deleted_by") @db.Uuid

  employee Employee  @relation(fields: [employeeId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  team     Team?     @relation(fields: [teamId], references: [id])
  function Function? @relation(fields: [functionId], references: [id])

  /// NOTE: partial uniques for one active primary company/team — raw SQL
  @@index([employeeId])
  @@index([companyId])
  @@index([teamId])
  @@index([effectiveTo])
  @@map("employee_assignments")
  @@schema("employee")
}

model EmployeeDocument {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String       @map("employee_id") @db.Uuid
  docType    DocumentType @map("doc_type")
  fileKey    String       @map("file_key") @db.VarChar(512)
  fileName   String       @map("file_name") @db.VarChar(255)
  mimeType   String?      @map("mime_type") @db.VarChar(120)
  uploadedAt DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz()
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy  String?      @map("created_by") @db.Uuid
  updatedBy  String?      @map("updated_by") @db.Uuid
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz()
  deletedBy  String?      @map("deleted_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
  @@schema("employee")
}

model EmployeeBankAccount {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  bankCode    String    @map("bank_code") @db.VarChar(20)
  accountNo   String    @map("account_no") @db.VarChar(128)
  accountName String    @map("account_name") @db.VarChar(160)
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy   String?   @map("deleted_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  /// NOTE: unique primary per employee WHERE is_primary AND deleted_at IS NULL — raw SQL
  @@index([employeeId])
  @@map("employee_bank_accounts")
  @@schema("employee")
}

