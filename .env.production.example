# ============================================================================
# WorkHQ production secrets — copy to /srv/workhq/.env on the VPS, chmod 600.
# NEVER commit the real file. Generate random values with:
#   openssl rand -hex 32        (URL-safe; use for every password below)
# Keep a copy of this file in the company password manager — especially
# BACKUP_ENCRYPTION_PASSPHRASE: without it the backups cannot be restored.
# ============================================================================

# ── Domain / TLS ────────────────────────────────────────────────────────────
WORKHQ_DOMAIN=hr.example.com
ACME_EMAIL=it@example.com

# ── Database / Redis (internal to the server) ───────────────────────────────
# Hex only: the password is embedded in the connection URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── API ─────────────────────────────────────────────────────────────────────
# At least 64 characters: openssl rand -hex 48
JWT_SECRET=
METRICS_TOKEN=

# ── Telegram (copy the bot token from the current Render service) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=workhq_staff_bot
TELEGRAM_WEBHOOK_SECRET=

# ── AWS S3 (documents + backups; region Singapore) ──────────────────────────
AWS_REGION=ap-southeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_RETENTION_DAYS=14            # copies kept on the VPS disk itself
# BACKUP_CRON_SCHEDULE=0 19 * * *     # UTC → 02:00 Bangkok

# ── Optional ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_DRIVE_EXPORT_FOLDER_ID=
