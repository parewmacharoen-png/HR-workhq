  companyId String?         @map("company_id") @db.Uuid
  category  SettingCategory
  key       String          @db.VarChar(120)
  value     Json
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company  Company?         @relation(fields: [companyId], references: [id])
  versions SettingVersion[]
  audits   SettingAudit[]

  /// NOTE: unique (COALESCE(company_id, zero-uuid), category, key) — expression index in raw SQL
  @@index([category, key])
  @@index([companyId, category])
  @@map("setting_profiles")
  @@schema("system")
}

model SettingVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingProfileId String   @map("setting_profile_id") @db.Uuid
  previousValue    Json?    @map("previous_value")
  newValue         Json     @map("new_value")
  changedBy        String   @map("changed_by") @db.Uuid
  changedAt        DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  profile SettingProfile @relation(fields: [settingProfileId], references: [id])

  @@index([settingProfileId, changedAt(sort: Desc)])
  @@map("setting_versions")
  @@schema("system")
}

model SettingAudit {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?          @map("profile_id") @db.Uuid
  companyId String?          @map("company_id") @db.Uuid
  category  SettingCategory?
  actorId   String           @map("actor_id") @db.Uuid
  action    String           @db.VarChar(40)
  key       String           @db.VarChar(120)
  oldValue  Json?            @map("old_value")
  newValue  Json?            @map("new_value")
  timestamp DateTime         @default(now()) @db.Timestamptz()

  profile SettingProfile? @relation(fields: [profileId], references: [id])

  @@index([companyId, timestamp(sort: Desc)])
  @@index([key, timestamp(sort: Desc)])
  @@map("setting_audits")
  @@schema("system")
}

model JobRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName    String    @map("job_name") @db.VarChar(120)
  status     JobStatus @default(running)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()
  error      String?
  payload    Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([jobName, startedAt])
  @@map("job_runs")
  @@schema("system")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz()
  processedAt   DateTime? @map("processed_at") @db.Timestamptz()
  attempts      Int       @default(0)

  /// NOTE: partial index on occurred_at WHERE processed_at IS NULL — raw SQL
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
  @@schema("system")
}

model BackupRegistry {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupType  BackupType @map("backup_type")
  location    String     @db.VarChar(512)
  sizeBytes   BigInt?    @map("size_bytes")
  startedAt   DateTime   @default(now()) @map("started_at") @db.Timestamptz()
  completedAt DateTime?  @map("completed_at") @db.Timestamptz()
  status      JobStatus  @default(running)
  checksum    String?    @db.VarChar(128)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([startedAt])
  @@map("backups_registry")
  @@schema("system")
}

