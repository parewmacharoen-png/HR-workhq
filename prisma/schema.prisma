// ============================================================================
// WorkHQ — Prisma Schema (Phase 4)
// Multi-schema PostgreSQL 16. Mirrors workhq_schema.sql exactly.
// Soft delete: deletedAt / deletedBy on business models (filter in app layer).
// Note: EXCLUDE constraints, partial-unique WHERE clauses, and append-only
// triggers live in raw SQL migrations — Prisma cannot express them. They are
// documented inline as /// NOTE comments where relevant.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
  output          = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, btree_gist, vector]
  schemas    = ["organization", "employee", "permission", "attendance", "leave", "workflow", "payroll", "commission", "finance", "performance", "recruitment", "referral", "marketing", "training", "assets", "knowledge", "ai", "reporting", "telegram", "system"]
}

