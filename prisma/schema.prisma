model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @db.VarChar(8)
  name      String   @db.VarChar(120)
  legalName String?  @map("legal_name") @db.VarChar(200)
  timezone  String   @default("Asia/Bangkok") @db.VarChar(40)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?  @map("deleted_by") @db.Uuid

  teams                 Team[]
  assignments           EmployeeAssignment[]
  scopeGrants           ScopeGrant[]
  featureFlags          FeatureFlag[]
  workflowInstances     WorkflowInstance[]
  documentRequests      DocumentRequest[]
  approvalAuthorityMatrices ApprovalAuthorityMatrix[]
  approvalDelegations   ApprovalDelegation[]
  attendanceRecords     AttendanceRecord[]
  absenceRecords        AbsenceRecord[]
  overtimeRecords       OvertimeRecord[]
  shifts                Shift[]
  monthlyOffRequests    MonthlyOffRequest[]
  workforceStaffingRules WorkforceStaffingRule[]
  leaveRequests         LeaveRequest[]
  leaveRescheduleRequests LeaveRescheduleRequest[]
  leaveShiftSwapRequests  LeaveShiftSwapRequest[]
  holidayConversions    HolidayConversion[]
  payrollCycles         PayrollCycle[]
  payrollItems          PayrollItem[]
  payrollExportBatches  PayrollExportBatch[]
  manualCommissionEntries ManualCommissionEntry[]
  manualPayrollItemDefinitions ManualPayrollItemDefinition[]
  salaryHistory         SalaryHistory[]
  deposits              Deposit[]
  legacyDepositEmployees Employee[] @relation("LegacyDepositCompany")
  depositCollectionEmployees Employee[] @relation("DepositCollectionCompany")
  commissionRecords     CommissionRecord[]
  bigLeaderLedgers      BigLeaderLedger[]
  marketingCommissionCycles MarketingCommissionCycle[]
  marketingCommissionCarryForwards MarketingCommissionCarryForward[]
  marketingDailyReports         MarketingDailyReport[]
  marketingReportAuditLogs      MarketingReportAuditLog[]
  marketingCycleLocks           MarketingCycleLock[]
  marketingExpenses             MarketingExpense[]
  marketingTeams                MarketingTeam[]
  marketingTeamMembers          MarketingTeamMember[]
  adminCommissionCycles AdminCommissionCycle[]
  adminCommissionEmployeeProfiles AdminCommissionEmployeeProfile[]
  adminCommissionShiftSegments AdminCommissionShiftSegment[]
  commissionCycles      CommissionCycle[]
  commissionAdjustments CommissionAdjustmentRequest[]
  commissionDeclarations CommissionDeclaration[]
  commissionDeclarationAssignments CommissionDeclarationAssignment[]
  advanceRequests       AdvanceRequest[]
  depositRefunds        DepositRefund[]
  depositLossClaims     DepositLossClaim[]
  employeeExitCases     EmployeeExitCase[]
  finalPayrollSettlements FinalPayrollSettlement[]
  disciplinaryActions   DisciplinaryAction[]
  employeeRecognitions  EmployeeRecognition[]
  ledgerEntries         LedgerEntry[]
  performanceCycles     PerformanceCycle[]
  evaluations           Evaluation[]
