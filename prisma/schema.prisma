model FinancialTransaction {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                   @map("company_id") @db.Uuid
  costCenterId       String?                  @map("cost_center_id") @db.Uuid
  budgetId           String?                  @map("budget_id") @db.Uuid
  type               FinanceTransactionType
  status             FinanceTransactionStatus @default(draft)
  category           String?                  @db.VarChar(80)
  amount             Decimal                  @db.Decimal(14, 2)
  currency           String                   @default("THB") @db.VarChar(8)
  transactionDate    DateTime                 @map("transaction_date") @db.Date
  description        String?
  counterparty       String?                  @db.VarChar(200)
  workflowInstanceId String?                  @map("workflow_instance_id") @db.Uuid
  ledgerEntryId      String?                  @map("ledger_entry_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy          String?                  @map("created_by") @db.Uuid
  updatedBy          String?                  @map("updated_by") @db.Uuid
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz()
  deletedBy          String?                  @map("deleted_by") @db.Uuid

  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])
  budget     Budget?     @relation(fields: [budgetId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])

  /// NOTE: CHECK amount>0 — raw SQL
  @@index([companyId, transactionDate])
  @@index([costCenterId])
  @@index([type, status])
  @@index([budgetId])
  @@map("financial_transactions")
  @@schema("finance")
}

