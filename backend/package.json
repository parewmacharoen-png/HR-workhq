{
  "name": "workhq-backend",
  "version": "0.1.0",
  "description": "WorkHQ — Telegram-first workforce management platform (backend)",
  "license": "UNLICENSED",
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:unit:watch": "jest --selectProjects unit --watch",
    "test:unit:cov": "jest --selectProjects unit --coverage",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:int:cov": "jest --selectProjects integration --coverage --runInBand",
    "test:e2e": "jest --selectProjects e2e",
    "test:all": "jest",
    "repair:telegram-onboarding-requests": "ts-node -r tsconfig-paths/register scripts/repair-telegram-onboarding-requests.ts",
    "local:seed-correction": "ts-node -r tsconfig-paths/register scripts/local-time-correction-demo.ts",
    "local:verify-correction": "ts-node -r tsconfig-paths/register scripts/verify-local-time-correction.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.59.0",
    "@sentry/node": "^10.59.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@prisma/internals": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
